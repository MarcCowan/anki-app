#!/usr/bin/env bash
# Scans every commit about to be pushed (diffs and messages). Fails closed: any problem blocks the push.
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
root="$(git rev-parse --show-toplevel)" || exit 1
zero='^0+$'
while read -r local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [[ "$local_sha" =~ $zero ]] && continue   # deleting a ref: nothing to scan
  if [[ "$remote_sha" =~ $zero ]] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    # New branch (or a remote commit we do not have): everything not already on a remote.
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  bash "$root/scripts/leakscan.sh" range "$range" || {
    echo "pre-push: leak scan blocked the push of $local_ref" >&2
    exit 1
  }
done
exit 0
